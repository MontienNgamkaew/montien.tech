Options -Indexes
DirectoryIndex index.php

# ป้องกันการเข้าถึงไฟล์สคีมา/ดัมป์ฐานข้อมูลโดยตรงผ่านเว็บ (เช่น database/*.sql)
<FilesMatch "\.(sql|bak)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^storage/(pdfs|reports|signatures)/(.+)$ /upload_serve.php?app=pnp-go&file=storage/$1/$2 [QSA,L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>
