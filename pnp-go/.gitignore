# === Composer ===
# vendor/ ถูก commit ขึ้น git (mPDF) เพื่อให้ git pull/checkout บน host ใช้ได้ทันที
# ยกเว้นฟอนต์ที่ mPDF แถมมา (88MB) ซึ่งไม่ได้ใช้ — เราใช้ THSarabunNew จาก storage/fonts
/vendor/mpdf/mpdf/ttfonts/
/vendor/mpdf/mpdf/tmp/
composer.phar

# === Storage (sessions, signatures, PDFs - ข้อมูลส่วนตัว) ===
/storage/sessions/
/storage/signatures/
/storage/pdfs/
/storage/mpdf-temp/
/storage/*.log
/storage/*.err

# === Config ที่มีข้อมูลสำคัญ (ถ้ามี .env ใช้ในอนาคต) ===
.env
.env.*
config/database.local.php

# === ไฟล์ทดสอบ / ชั่วคราว ===
test.php
scripts/fix_vendor_charset.php

# === OS / Editor ===
.DS_Store
Thumbs.db
.idea/
.vscode/settings.json
*.swp
*.swo

# === Log ===
*.log
