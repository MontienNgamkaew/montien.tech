# -------------------------------------------------------------
# PNP e-Service — ตัวอย่างไฟล์ตั้งค่าลับ (.env)
# -------------------------------------------------------------
# วิธีใช้:
#   1. คัดลอกไฟล์นี้เป็น .env  (cp .env.example .env)
#   2. กรอกค่าจริงลงใน .env  (ห้าม commit .env ขึ้น git)
#   3. บนเซิร์ฟเวอร์ production ให้สร้าง .env ที่ราก pnp-portal/ ก่อน deploy
# -------------------------------------------------------------

# ===== JWT (ใช้ร่วมกันทั้ง Portal และทุกระบบย่อย) =====
# ต้องเป็นค่าเดียวกันทุกระบบ มิฉะนั้น SSO จะใช้ไม่ได้
# สร้างคีย์สุ่มแข็งแรงด้วย:  php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET_KEY=change_me_to_a_long_random_secret
JWT_EXPIRY_SECONDS=604800

# ===== ฐานข้อมูลกลาง Portal (ใช้โดย api/ และ pnpman) =====
DB_HOST=localhost
DB_NAME=pnp_portal
DB_USER=root
DB_PASS=

# ===== ฐานข้อมูลระบบ pnp-go (carrequest) =====
# หมายเหตุ: pnp-go ยังรองรับไฟล์ pnp-go/config/database.local.php ด้วย
PNPGO_DB_HOST=127.0.0.1
PNPGO_DB_PORT=3306
PNPGO_DB_NAME=carrequest
PNPGO_DB_USER=root
PNPGO_DB_PASS=

# ===== ฐานข้อมูลระบบ pnp-academix =====
# บน production ต้องตั้งค่าจริง (โดยเฉพาะ ACADEMIX_DB_PASS) มิฉะนั้นระบบวิชาการจะเชื่อม DB ไม่ได้
ACADEMIX_DB_HOST=localhost
ACADEMIX_DB_NAME=pnp_academix
ACADEMIX_DB_USER=root
ACADEMIX_DB_PASS=

# ===== คีย์บำรุงรักษา (Maintenance) =====
# ใช้ป้องกันสคริปต์บำรุงรักษา เช่น pnp-go/sync_portal_users.php
# สร้างคีย์สุ่มด้วย:  php -r "echo bin2hex(random_bytes(16));"
MAINTENANCE_KEY=change_me_to_a_random_maintenance_key

# ===== CORS =====
# รายชื่อ origin ที่อนุญาต คั่นด้วยจุลภาค  หากเว้นว่างหรือใส่ * จะอนุญาตทุก origin (พฤติกรรมเดิม)
# แนะนำสำหรับ production:
# CORS_ALLOWED_ORIGINS=https://pnp-portal.montien.tech,https://pnp-go.montien.tech,https://pnp-man.montien.tech,https://pnp-edu.montien.tech
CORS_ALLOWED_ORIGINS=*
